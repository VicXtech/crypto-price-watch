    {
      "parameters": {
        "resource": "Chatting",
        "operation": "Send Text",
        "session": "default",
        "chatId": "5511999999999@c.us",
        "text": "=⚠️ *ALERTA DE ANOMALIA DE PREÇO* ⚠️\n\nA criptomoeda *{{ $json.symbol }}* ({{ $json.coingecko_id }}) apresentou um comportamento de preço fora do comum!\n\n💵 *Preço no Alerta:* ${{ $json.current_price >= 1 ? $json.current_price.toFixed(2) : $json.current_price }}\n📊 *Score do Isolation Forest:* {{ $json.anomaly_score.toFixed(4) }}\n🕒 *Horário (Brasília):* {{ $json.detected_at_brasilia }}\n\n_Verifique o painel do Streamlit para mais detalhes._\n",
        "requestOptions": {}
      },
      "type": "@devlikeapro/n8n-nodes-waha.WAHA",
      "typeVersion": 202502,
      "position": [
        1184,
        -64
      ],
      "id": "742472bc-3bb5-4e94-beab-b2baffe06e07",
      "name": "Aviso de Anomalia Detectada"
