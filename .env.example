# Database Credentials (utilizado pelo docker-compose)
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto_dev_password
POSTGRES_DB=crypto_price_watch

# Database URL completa (utilizada quando você rodar scripts/Streamlit fora do Docker na sua máquina)
DATABASE_URL=postgresql://crypto:crypto_dev_password@localhost:5432/crypto_price_watch

# API Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Feature & ML Configuration
MIN_SAMPLES_FEATURES=6
MIN_SAMPLES_TRAIN=50
SMA_WINDOW=6
EMA_WINDOW=24
ANOMALY_CONTAMINATION=0.02
